{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brand": "Actuaria Consultores",
    "version": "2026-07",
    "note": "Fuente canónica de tokens de marca. Si un valor no está aquí, no es de marca."
  },
  "color": {
    "brand": {
      "navy":   { "value": "#151F47", "pantone": "2766 C", "cmyk": "100/92/40/44", "rgb": "21,31,71",  "role": "institucional" },
      "azul":   { "value": "#3061AA", "pantone": "7455 C", "cmyk": "87/66/1/0",    "rgb": "48,97,170", "role": "secundario" },
      "naranja":{ "value": "#DF5E2D", "pantone": "7579 C", "cmyk": "8/77/94/1",    "rgb": "223,94,45", "role": "acento" }
    },
    "neutral": {
      "surface":     { "value": "#E8ECF4", "role": "superficie base" },
      "light":       { "value": "#D9DEEB", "role": "neutro claro" },
      "white":       { "value": "#FFFFFF" },
      "naranja-soft":{ "value": "#FFBBA1", "role": "texto naranja sobre navy (AA)" }
    },
    "ui": {
      "success": { "500": "#00C781", "100": "#66DDB3", "text": "#00B374" },
      "warning": { "500": "#FFBB38", "100": "#FFD688", "text": "#E6A832" },
      "danger":  { "500": "#FF4040", "100": "#FF8C8C", "text": "#CC3333" },
      "info":    { "500": "#3C76F1", "100": "#ECF1FE", "text": "#366AD9" }
    }
  },
  "typography": {
    "wordmark":   { "family": "Lemon Milk", "webFallback": "Jost", "weight": 600, "usage": "solo logo" },
    "system":     { "family": "Nunito", "source": "Google Fonts", "weights": [400, 600, 700, 800, 900], "usage": "UI, cuerpo, documentos" }
  },
  "proportion": { "rule": "60/30/10", "detail": "60% navy/neutro · 30% azul · 10% naranja (acento)" },
  "logo": {
    "type": "imagotipo",
    "symbol": "velero",
    "symbolColors": { "jib": "#DF5E2D", "velaMayor": "#151F47", "casco": "#3061AA" },
    "versions": ["horizontal", "vertical", "byn", "una-tinta", "negativo"],
    "safeArea": { "unit": "x = altura de la A del wordmark", "min": "0.5x" },
    "rules": ["el símbolo nunca va a la derecha del wordmark", "no recolorear el wordmark", "no condensar ni estirar la tipografía"]
  },
  "shape": {
    "radius": { "sm": "5.333px", "md": "16px", "lg": "48px" }
  },
  "brand": {
    "claim": "Trazamos el camino juntos.",
    "archetype": "El Tutor (El Sabio + El Cuidador)",
    "values": { "CREE": "cultura (letras pendientes v2)", "ACTUA": "acción (letras pendientes v2)" },
    "metaphor": "cartas de navegación / mar de datos"
  }
}
